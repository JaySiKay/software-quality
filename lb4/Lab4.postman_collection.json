  "item": [
    {
      "name": "01 GET with Params",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();\r",
              "\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Response is json\", function () {\r",
              "    const contentType = pm.response.headers.get(\"Content-Type\"); \r",
              "    pm.expect(contentType).to.include(\"application/json\");\r",
              "});\r",
              "\r",
              "pm.test(\"Name is Yuliia\", function () {\r",
              "    pm.expect(json.args.name).to.eql(\"Yuliia\");\r",
              "});\r",
              "\r",
              "pm.test(\"Role is student\", function () {\r",
              "    pm.expect(json.args.role).to.eql(\"student\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/get?name=Yuliia&role=student",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "get"
          ],
          "query": [
            {
              "key": "name",
              "value": "Yuliia"
            },
            {
              "key": "role",
              "value": "student"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "02 POST JSON",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();\r",
              "\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Response contains product\", function () {\r",
              "    pm.expect(json.data).to.have.property(\"product\");\r",
              "});\r",
              "\r",
              "pm.test(\"Product is Backpack\", function () {\r",
              "    pm.expect(json.data.product).to.eql(\"Backpack\");\r",
              "});\r",
              "\r",
              "pm.test(\"Quantity is 2\", function () {\r",
              "    pm.expect(json.data.quantity).to.eql(2);\r",
              "});\r",
              "\r",
              "pm.test(\"Quantity is a number\", function () {\r",
              "    pm.expect(json.data.quantity).to.be.a(\"number\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"product\": \"Backpack\",\r\n    \"quantity\": 2\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/post",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "post"
          ]
        }
      },
      "response": []
    },
    {
