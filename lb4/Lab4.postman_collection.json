              "pm.test(\"Status code is 404\", function () {\r",
              "    pm.response.to.have.status(404);\r",
              "});\r",
              "\r",
              "pm.test(\"Response status is 404\", function () {\r",
              "    pm.expect(json.status).to.eql(404);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/status/404",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "status",
            "404"
          ]
        }
      },
      "response": []
